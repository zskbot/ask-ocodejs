# Gemini provider (only required when using Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional custom/self-hosted provider
OHMABA_URL=
OHMABA_API_KEY=

# Default provider/model alias
DEFAULT_MODEL=zsk

# Firebase Authentication project used to verify ID tokens server-side.
FIREBASE_PROJECT_ID=gen-lang-client-0137515073

# v0 Platform API key. Configure in Vercel Project Settings > Environment Variables.
# Keep server-only: never prefix with VITE_ or NEXT_PUBLIC_.
V0_API_KEY=

# Optional origin allow-list for a separately hosted API.
ALLOWED_ORIGIN=
