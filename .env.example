# Gemini provider (only required when using Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional custom/self-hosted provider
OHMABA_URL=
OHMABA_API_KEY=

# Default provider/model alias
APP_URL=
SEARCH_API_KEY=

# Default provider/model alias
DEFAULT_MODEL=zsk

# Firebase Authentication project used to verify ID tokens server-side.
FIREBASE_PROJECT_ID=gen-lang-client-0137515073

# v0 Platform API key. Configure in Vercel Project Settings > Environment Variables.
# Keep server-only: never prefix with VITE_ or NEXT_PUBLIC_.
V0_API_KEY=
# Restrict paid v0 access to an explicit comma-separated allow-list.
V0_ALLOWED_EMAILS=
# Optional alternative to email allow-list: Firebase UIDs, comma-separated.
V0_ALLOWED_UIDS=

# Required in production: shared distributed rate limits (Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional origin allow-list for a separately hosted API.
ALLOWED_ORIGIN=
